   ========================= */

.dashboard {
    display: grid;
    gap: 20px;
    width: 100%;
    transition: grid-template-columns 0.25s ease;
}

/* =========================
   Layout variants (CSS-only)
   ========================= */

.dashboard.layout-side {
    grid-template-columns: 2fr 2fr 1fr;
}

.dashboard.layout-stacked {
